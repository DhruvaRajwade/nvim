return {
	{
		"lukas-reineke/indent-blankline.nvim",
		config = function()
			require("ibl").setup({
				indent = {
					char = "│", -- Set indent line character
				},
				scope = {
					enabled = true, -- Enable scope highlighting
					show_start = true,
					show_end = false,
				},
				exclude = {
					filetypes = { "help", "terminal", "dashboard" }, -- Exclude these filetypes
					buftypes = { "terminal", "nofile" },
				},
			})
		end,
	},
}
